# Per-machine launch settings for scripts/run-app.sh.
#
# Copy to .dt-env (gitignored) and edit. Every launch path — `make run`,
# `nix run`, the neovim <leader>pr mapping — reads this same file, so your
# machine-specific choices apply everywhere without any of them growing its own
# copy of the launch logic.
#
# Anything set in the environment still wins:
#   DT_PORT=9090 make run
#
# This file is sourced by bash, so ordinary shell syntax applies.

# Run mode: "desktop" opens the application window, "server" runs headless for
# a browser to connect to. Defaults to desktop; `make serve` picks server.
#DT_MODE=desktop

# Where the data lives. Leave unset to use the app's own resolution: saved
# settings first, then ./data, then ~/.local/share/decision-theatre/data.
#DT_DATA_DIR=./data
#DT_RESOURCES_DIR=./resources

# HTTP port. The app walks forward from here if the port is busy.
#DT_PORT=8080

# Interface to listen on. Defaults to 127.0.0.1, because the API has no
# authentication of its own — 0.0.0.0 hands it to everyone who can reach this
# machine. Set it when you want to open the app in a browser or on a phone on
# your own network, and only on a network you trust.
#DT_BIND=0.0.0.0

# Skip the staleness checks entirely and launch the existing bin/decision-theatre.
#DT_SKIP_BUILD=1

# Rebuild frontend, docs and binary on every launch.
#DT_FORCE_BUILD=1

# Key for the MapTiler satellite basemap and font-glyph proxy. Without it,
# those features fail upstream and the app falls back to the built-in
# basemap / unlabelled glyphs rather than erroring outright — but you'll want
# your own key for a working satellite view. Get one at maptiler.com.
#DT_MAPTILER_API_KEY=
