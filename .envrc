# direnv configuration.
#
# `use flake` builds the devShell and exports its environment. It exports
# variables only — shell functions and aliases defined in the flake's shellHook
# do not survive, because direnv evaluates the hook in a subshell and carries
# back the environment, not the shell state.
#
# That is why `dt` and `hp` are executables in devbin/ rather than functions:
# putting the directory on PATH is something direnv can do, and it makes the
# commands work identically whether you use direnv, `nix develop`, or neither.
use flake

PATH_add devbin

watch_file flake.nix
watch_file scripts/dev-shell.sh
