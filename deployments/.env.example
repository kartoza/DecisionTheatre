# Public ports exposed by nginx.
HTTP_PORT=80
HTTPS_PORT=443

# Host paths on the deployment server.
DT_DATA_DIR=../data
DT_RESOURCES_DIR=../resources

# Wits-issued certificate and private key.
# Use a full certificate chain file if Wits/Sectigo provides one.
TLS_CERT_FILE=./certs/tls.crt
TLS_KEY_FILE=./certs/tls.key

# Satellite basemap and font-glyph proxy key (internal/config.MapTilerAPIKey).
# Leave empty to run without a working satellite basemap.
DT_MAPTILER_API_KEY=
