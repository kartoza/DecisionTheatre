# Environment files are never committed — anywhere, not just where one has
# already caught us out. Build-time configuration belongs to the deployment,
# and a tracked *.env also fails the repository's own secret-scanning gate.
# The .example files are documentation and stay tracked; they do not match
# these patterns.
*.env
.env
.env.*
!.env.example
!*.env.example

# Screenshots shared during development, not part of the source
screenshots-gitignored/
